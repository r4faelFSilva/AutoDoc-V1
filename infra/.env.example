# Variáveis lidas pelo infra/docker-compose.yml (ambiente de DESENVOLVIMENTO).
# Copie para infra/.env e preencha. Nunca versione o .env.
# As senhas entram em URLs de conexão: use caracteres seguros para URL, por exemplo
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Postgres ---
POSTGRES_USER=autodoc
# Obrigatória. Só vale na criação do volume pgdata.
POSTGRES_PASSWORD=
POSTGRES_DB=autodoc

# --- Redis ---
# Obrigatória.
REDIS_PASSWORD=

# --- API e worker ---
# production (padrão) exige JWT_SECRET forte; development relaxa as checagens.
APP_ENV=production
# Obrigatória, 32+ caracteres aleatórios.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:4200

# Cadastro público e usuário demo (ambos desligados por padrão)
ALLOW_REGISTRATION=false
SEED_DEMO_USER=false
DEMO_PASSWORD=

# IA
# LLM_PROVIDER: openai | anthropic | openai_compatible (ver backend/.env.example)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_JSON_MODE=false

# GitHub: o token do servidor só é usado em nome dos usuários com ALLOW_SERVER_GITHUB_TOKEN=true
GITHUB_TOKEN=
ALLOW_SERVER_GITHUB_TOKEN=false

# Gerador de testes: none | docker | local
# (docker exigiria montar o socket do Docker no container — não configurado aqui)
TESTGEN_EXECUTION=none
