# SQLite (default path used if unset: backend/data/autodoc.db)
# DATABASE_URL=sqlite:///./data/autodoc.db

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: higher GitHub API rate limits and private repos
GITHUB_TOKEN=

# --- Servidor de desenvolvimento ---
# Use --reload-dir app para NÃO observar .venv (senão o WatchFiles entra em loop de reload).
#   python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8000
# Ou:  .\run_dev.ps1
