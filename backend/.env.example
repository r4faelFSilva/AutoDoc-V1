# Modelo do backend/.env para DESENVOLVIMENTO LOCAL.
# Copie para backend/.env e preencha as chaves. Nunca versione o .env.

# --- Ambiente ---
# development: relaxa as checagens de inicialização (ex.: aceita o JWT_SECRET de exemplo).
# production (padrão quando ausente): a API recusa subir com JWT_SECRET padrão ou curto.
APP_ENV=development

# --- Banco de dados ---
# SQLite (padrão se ausente: backend/data/autodoc.db)
# DATABASE_URL=sqlite:///./data/autodoc.db
# Com Docker Compose: DATABASE_URL=postgresql+psycopg://autodoc:<POSTGRES_PASSWORD>@localhost:5432/autodoc

# --- Autenticação ---
# Fora de development: 32+ caracteres aleatórios. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
# Validade do token de login, em minutos (padrão: 1440 = 24 horas)
JWT_EXPIRE_MINUTES=1440

# Cadastro público pela tela/rota /api/auth/register (padrão: false).
# Desligado, crie contas com: python -m app.scripts.create_user --email voce@exemplo.com
ALLOW_REGISTRATION=false

# Usuário demo demo@autodoc.dev (padrão: false). Só para desenvolvimento.
# Sem DEMO_PASSWORD, uma senha aleatória é gerada e exibida uma única vez no log.
SEED_DEMO_USER=true
DEMO_PASSWORD=

# Origens aceitas pelo CORS, separadas por vírgula (padrão: http://localhost:4200)
CORS_ORIGINS=http://localhost:4200

# --- IA ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provider usado pelos agentes: "openai" (padrão) ou "anthropic"
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Orçamento por run de agente
AGENT_MAX_OUTPUT_TOKENS=8000

# Limite de tempo TOTAL de um run, em segundos. Ao estourar, o run é interrompido
# e marcado como falha com mensagem clara na tela.
#   AGENT_RUN_TIMEOUT_SECONDS:      documentador no modo quick (padrão: 300 = 5 min)
#   AGENT_RUN_TIMEOUT_DEEP_SECONDS: modo deep, arquiteto e gerador de testes (padrão: 900 = 15 min)
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_RUN_TIMEOUT_DEEP_SECONDS=900

# Cada chamada à IA: tempo máximo por tentativa, em segundos (padrão: 120),
# e quantas vezes o SDK tenta de novo após falha temporária (padrão: 1).
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# --- Fila de jobs ---
# Vazio = modo fallback (jobs in-process, sem Redis).
# Com Docker Compose: REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
REDIS_URL=

# --- Gerador de testes ---
# Execução dos testes gerados pelo agente gerador_testes:
#   none   (padrão) gera e valida a sintaxe, mas NÃO executa
#   docker container efêmero sem rede (requer Docker acessível ao backend)
#   local  subprocess na própria máquina — só em dev, com código de confiança
TESTGEN_EXECUTION=none

# --- GitHub ---
# Token do servidor (rate limit maior / repos privados). Por padrão ele NÃO é usado
# em nome dos usuários: cada usuário informa o próprio token na requisição.
GITHUB_TOKEN=
# true = usa GITHUB_TOKEN quando o usuário não enviar token (padrão: false).
# Atenção: qualquer usuário logado passa a ler os repositórios que esse token acessa.
ALLOW_SERVER_GITHUB_TOKEN=false
# Download de repositórios: tempo total em segundos (padrão: 60) e tamanho máximo
# do arquivo compactado em MB (padrão: 50; a extração aceita até 4x esse valor).
GITHUB_DOWNLOAD_TIMEOUT_SECONDS=60
GITHUB_MAX_DOWNLOAD_MB=50

# --- Servidor MCP (mcp-server/server.py) — lidas pelo processo do MCP ---
# AUTODOC_API_URL=http://localhost:8000
# AUTODOC_EMAIL=          (obrigatória)
# AUTODOC_PASSWORD=       (obrigatória)
# AUTODOC_TIMEOUT=300
# AUTODOC_MCP_HOST=127.0.0.1
# AUTODOC_MCP_PORT=8765

# --- Servidor de desenvolvimento ---
# Use --reload-dir app para NÃO observar .venv (senão o WatchFiles entra em loop de reload).
#   python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8000
# Ou:  .\run_dev.ps1
