# SQLite (default path used if unset: backend/data/autodoc.db)
# DATABASE_URL=sqlite:///./data/autodoc.db

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agentes (Fase 0) ---
# Provider usado pelos agentes: "openai" (padrão) ou "anthropic"
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Vazio = modo fallback (jobs in-process, sem Redis).
# Com Docker Compose: REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Com Docker Compose: DATABASE_URL=postgresql+psycopg://autodoc:autodoc@localhost:5432/autodoc

# Optional: higher GitHub API rate limits and private repos
GITHUB_TOKEN=

# --- Servidor de desenvolvimento ---
# Use --reload-dir app para NÃO observar .venv (senão o WatchFiles entra em loop de reload).
#   python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8000
# Ou:  .\run_dev.ps1
